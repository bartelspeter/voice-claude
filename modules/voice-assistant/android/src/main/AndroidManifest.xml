<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Granted once over adb so walk mode can switch the voice tap service on and off. -->
  <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />

  <!-- The earbud can hand off to the official Claude app instead. -->
  <queries>
    <package android:name="com.anthropic.claude" />
  </queries>

  <application>
    <!-- Default digital assistant: the earbud long press (Bluetooth voice recognition) lands here. -->
    <service
      android:name="expo.modules.voiceassistant.AssistInteractionService"
      android:permission="android.permission.BIND_VOICE_INTERACTION"
      android:exported="true">
      <meta-data
        android:name="android.voice_interaction"
        android:resource="@xml/assistant_service" />
      <intent-filter>
        <action android:name="android.service.voice.VoiceInteractionService" />
      </intent-filter>
    </service>

    <service
      android:name="expo.modules.voiceassistant.AssistSessionService"
      android:permission="android.permission.BIND_VOICE_INTERACTION"
      android:exported="true" />

    <!-- Android requires a recognition service for an assistant app; we do STT ourselves. -->
    <service
      android:name="expo.modules.voiceassistant.StubRecognitionService"
      android:exported="true">
      <intent-filter>
        <action android:name="android.speech.RecognitionService" />
      </intent-filter>
      <meta-data
        android:name="android.speech"
        android:resource="@xml/recognition_service" />
    </service>

    <!-- Some phones/headsets fire intents instead of starting the assistant session. -->
    <activity
      android:name="expo.modules.voiceassistant.AssistTrampolineActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:showWhenLocked="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.ASSIST" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VOICE_COMMAND" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
      <!-- Headset button long press goes through MediaSessionService, which sends these. -->
      <intent-filter>
        <action android:name="android.speech.action.WEB_SEARCH" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.speech.action.VOICE_SEARCH_HANDS_FREE" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>

    <!-- Taps Claude's voice button after the earbud hands off to the Claude app. -->
    <service
      android:name="expo.modules.voiceassistant.ClaudeVoiceTapService"
      android:label="Voice Claude earbud tap"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:exported="false">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/voice_tap_service" />
    </service>

    <!-- Keeps the mic alive while a conversation runs with the screen off. -->
    <service
      android:name="expo.modules.voiceassistant.ConversationService"
      android:exported="false"
      android:foregroundServiceType="microphone" />

    <!-- Walk mode: turn the voice tap service off for banking apps, on for walks. -->
    <service
      android:name="expo.modules.voiceassistant.WalkModeTileService"
      android:exported="true"
      android:icon="@android:drawable/ic_btn_speak_now"
      android:label="Walk mode"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
      <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
    </service>

    <activity
      android:name="expo.modules.voiceassistant.WalkModeToggleActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:theme="@android:style/Theme.NoDisplay" />
  </application>
</manifest>
